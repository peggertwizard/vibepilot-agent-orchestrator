{
  "name": "vibepilot",
  "version": "0.4.4",
  "description": "Agent orchestrator — talk to a Pilot, it delegates to teammates in isolated worktrees.",
  "main": "./out/main/index.js",
  "author": "peggert",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "compliance": "node scripts/check-compliance.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && node scripts/release.mjs",
    "publish:source": "node scripts/publish-source.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  }
}
